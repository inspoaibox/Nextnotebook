# 暮城笔记同步服务器 - 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ============ 基础配置 ============
# 服务器端口
PORT=3000

# 数据库路径
DATABASE_PATH=./data/sync.db

# 资源文件存储路径
RESOURCES_PATH=./data/resources

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# ============ 安全配置（重要！）============
# JWT 访问令牌密钥（必须设置，至少32字符）
# 可以使用以下命令生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-string-at-least-32-characters

# JWT 刷新令牌密钥（必须设置，至少32字符）
JWT_REFRESH_SECRET=another-secure-random-string-at-least-32-characters

# 访问令牌过期时间（秒），默认 3600（1小时）
ACCESS_TOKEN_EXPIRES_IN=3600

# 刷新令牌过期时间（秒），默认 604800（7天）
REFRESH_TOKEN_EXPIRES_IN=604800

# ============ CORS 配置 ============
# 允许的来源，多个用逗号分隔，* 表示允许所有（不推荐用于生产环境）
# 示例: https://your-domain.com,https://app.your-domain.com
CORS_ORIGINS=*

# ============ 代理配置 ============
# 如果服务器在反向代理（如 Nginx）后面，设置为 true 以获取真实客户端 IP
TRUST_PROXY=false

# 安全模式（强制 HTTPS，生产环境建议开启）
SECURE_MODE=false

# ============ 频率限制配置 ============
# API 请求限制（每分钟）
API_RATE_LIMIT=10000

# 登录尝试限制（每15分钟）
LOGIN_RATE_LIMIT=5

# 注册尝试限制（每小时）
REGISTER_RATE_LIMIT=3

# ============ 存储配置 ============
# 单个资源文件最大大小（字节），默认 100MB
MAX_RESOURCE_SIZE=104857600

# 变更日志保留天数
CHANGE_LOG_RETENTION_DAYS=7

# ============ API Key（可选，用于向后兼容）============
# 多个 API Key 用逗号分隔
# API_KEYS=key1,key2,key3

# ============ 快传中继服务器配置 ============
# 是否启用快传中继服务（默认启用）
TRANSFER_RELAY_ENABLED=true

# 中继服务器连接密钥（必须设置！客户端需要此密钥才能连接）
# 可以使用以下命令生成: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TRANSFER_RELAY_KEY=your-relay-key-at-least-16-characters

# Socket.IO 路径
TRANSFER_RELAY_PATH=/transfer

# 最大同时连接数
TRANSFER_MAX_CONNECTIONS=100

# 每分钟最大消息数（每个连接）
TRANSFER_MESSAGE_RATE_LIMIT=60

# 每分钟最大文件传输数（每个连接）
TRANSFER_FILE_RATE_LIMIT=10

# 会话超时时间（毫秒），默认 30 分钟
TRANSFER_SESSION_TIMEOUT=1800000

# 心跳间隔（毫秒），默认 30 秒
TRANSFER_HEARTBEAT_INTERVAL=30000
